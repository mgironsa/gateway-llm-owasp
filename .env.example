# Copia este archivo a .env y completa los valores:  copy .env.example .env
# NUNCA subas el archivo .env a git (ya está en .gitignore).

# ── Proveedor: mock (offline, para pruebas) o gemini (real) ──
PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Clientes del gateway: alias:key separados por coma ──
# Genera cada key con: python tools/generar_api_key.py
CLIENT_API_KEYS=cliente-a:,cliente-b:

# ── Sal secreta para el HMAC de prompts en los logs ──
# Genera una con: python tools/generar_api_key.py
LOG_HMAC_KEY=

# ── Interruptores de mitigación: true = protección activa, false = línea base ──
MITIGATION_LLM10=true
MITIGATION_LLM01=true
MITIGATION_LLM07=true
MITIGATION_LLM02=true
MITIGATION_SAFE_LOGGING=true

# ── Parámetros ──
RATE_LIMIT=10/minute
MAX_PROMPT_CHARS=2000
MAX_OUTPUT_TOKENS=300

# ── Solo proveedor mock: ninguna | timeout | auth | malformada ──
MOCK_FALLA=ninguna
